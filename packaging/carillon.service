[Unit]
Description=Carillon NTP time daemon
Documentation=https://github.com/ptudor/carillon-time
After=network-online.target
Wants=network-online.target
Conflicts=ntp.service ntpd.service ntpsec.service chrony.service chronyd.service systemd-timesyncd.service

[Service]
Type=simple
User=carillon
Group=carillon
ExecStartPre=/usr/bin/carillon -check -config /etc/carillon/carillon.toml
ExecStart=/usr/bin/carillon -config /etc/carillon/carillon.toml
Restart=on-failure
RestartSec=5s
UMask=0027
RuntimeDirectory=carillon
RuntimeDirectoryMode=0750
StateDirectory=carillon
StateDirectoryMode=0750
AmbientCapabilities=CAP_SYS_TIME CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_SYS_TIME CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
# Network-only by default. GPS/PPS device access is an explicit systemd drop-in.
PrivateDevices=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

[Install]
WantedBy=multi-user.target
