# carillon — NTP-compatible time daemon with serial-port PPS.
#
# Install to /etc/systemd/system/carillon.service. One-time setup:
#
#   groupadd --system carillon
#   useradd --system -g carillon -G dialout -d /nonexistent -s /usr/sbin/nologin carillon
#   install -d -o carillon -g carillon -m 750 /var/lib/carillon
#   install -d -m 755 /etc/carillon
#   install -m 644 carillon.toml.example /etc/carillon/carillon.toml
#   # keys file, only if authenticated servers are configured:
#   ( umask 077; printf '1 AES128CMAC %s\n' "$(openssl rand -hex 16)" > /etc/carillon/keys )
#   chown carillon:carillon /etc/carillon/keys
#   carillon -check -config /etc/carillon/carillon.toml
#   systemctl disable --now systemd-timesyncd chrony ntp 2>/dev/null
#   systemctl enable --now carillon
#
# Serial-port PPS (later milestone) needs the pps_ldisc module:
#   echo pps_ldisc > /etc/modules-load.d/carillon.conf

[Unit]
Description=carillon NTP time daemon
Documentation=file:///usr/local/share/doc/carillon/DESIGN.md
After=network-online.target
Wants=network-online.target
Conflicts=ntp.service ntpd.service chrony.service chronyd.service systemd-timesyncd.service

[Service]
Type=simple
ExecStartPre=/usr/local/sbin/carillon -check -config /etc/carillon/carillon.toml
ExecStart=/usr/local/sbin/carillon -config /etc/carillon/carillon.toml
Restart=on-failure
RestartSec=5s

User=carillon
Group=carillon
SupplementaryGroups=dialout

# The daemon does no privilege dropping itself; these are the only
# privileges it needs: set the clock, bind port 123.
AmbientCapabilities=CAP_SYS_TIME CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_SYS_TIME CAP_NET_BIND_SERVICE
NoNewPrivileges=yes

ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/carillon /run
PrivateTmp=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX

# Serial port and PPS devices for the refclock. Adjust the tty to match
# the configured device.
DeviceAllow=/dev/ttyS0 rw
DeviceAllow=char-pps rw

[Install]
WantedBy=multi-user.target
