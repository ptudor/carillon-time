#!/bin/sh

# PROVIDE: carillon
# REQUIRE: NETWORKING
# BEFORE: LOGIN
# KEYWORD: shutdown
#
# Add the following lines to /etc/rc.conf to enable carillon:
#
# carillon_enable="YES"
#
# Optional settings (defaults shown):
#
# carillon_config="/usr/local/etc/carillon/carillon.toml"
# carillon_user="carillon"
# carillon_group="carillon"
#
# One-time setup
# --------------
# 1. Account. The daemon runs unprivileged; group dialer is what grants
#    access to /dev/cuau* for the PPS/GPS refclock (later milestone).
#
#      pw groupadd carillon
#      pw useradd carillon -g carillon -G dialer -d /nonexistent \
#          -s /usr/sbin/nologin -c "carillon time daemon"
#      install -d -o carillon -g carillon -m 750 /var/db/carillon
#      install -d -o root -g wheel -m 755 /usr/local/etc/carillon
#
# 2. Clock privileges. carillon adjusts the clock with ntp_adjtime(2) and
#    clock_settime(2) and binds UDP port 123; the
#    mac_ntpd(4) policy grants exactly those privileges (PRIV_ADJTIME,
#    PRIV_CLOCK_SETTIME, PRIV_NTP_ADJTIME, PRIV_NETINET_RESERVEDPORT,
#    PRIV_NETINET_REUSEPORT) to one uid. Add to /boot/loader.conf:
#
#      mac_ntpd_load="YES"
#      security.mac.ntpd.uid=<uid of carillon>     # id -u carillon
#
#    Without this the daemon fails at startup with a privilege error from
#    ntp_adjtime rather than running silently uncorrected.
#
# 3. Config and keys.
#
#      install -m 644 carillon.toml.example /usr/local/etc/carillon/carillon.toml
#      # keys file, only if authenticated servers are configured:
#      ( umask 077; printf '1 AES128CMAC %s\n' "$(openssl rand -hex 16)" \
#          > /usr/local/etc/carillon/keys )
#      chown carillon:carillon /usr/local/etc/carillon/keys
#      carillon -check -config /usr/local/etc/carillon/carillon.toml
#
# 4. Make sure no other time daemon is enabled: carillon refuses to start
#    while ntpd_enable or chronyd_enable is YES.

. /etc/rc.subr

name="carillon"
rcvar="${name}_enable"

load_rc_config $name

: ${carillon_enable:="NO"}
: ${carillon_user:="carillon"}
: ${carillon_group:="carillon"}
: ${carillon_config:="/usr/local/etc/carillon/carillon.toml"}

pidfile="/var/run/${name}.pid"
command="/usr/sbin/daemon"
procname="/usr/local/sbin/carillon"
command_args="-f -p ${pidfile} -u ${carillon_user} ${procname} -config ${carillon_config}"

start_precmd="${name}_prestart"

carillon_prestart()
{
	if checkyesno ntpd_enable; then
		err 1 "ntpd_enable is YES in rc.conf; two time daemons must not discipline one clock"
	fi
	if checkyesno chronyd_enable; then
		err 1 "chronyd_enable is YES in rc.conf; two time daemons must not discipline one clock"
	fi
	if [ ! -f "${carillon_config}" ]; then
		err 1 "config not found: ${carillon_config}"
	fi
	install -d -o ${carillon_user} -g ${carillon_group} -m 750 /var/run/carillon
	if ! ${procname} -check -config "${carillon_config}"; then
		err 1 "config check failed: ${carillon_config}"
	fi
	install -o ${carillon_user} -g ${carillon_group} -m 644 /dev/null ${pidfile}
}

run_rc_command "$1"
