# carillon configuration — NTP client/server with optional PPS refclock.
#
# Install as:
#   /usr/local/etc/carillon/carillon.toml   (FreeBSD)
#   /etc/carillon/carillon.toml             (Linux)
# or pass -config /path/to/carillon.toml.
#
# Unknown keys are errors: a typo will stop the daemon from starting rather
# than silently doing nothing. Validate with: carillon -check -config <path>

[daemon]
# Last known frequency correction, read at start and written hourly.
#   FreeBSD default: /var/db/carillon/drift
#   Linux default:   /var/lib/carillon/drift
#drift_file = "/var/db/carillon/drift"

# Unix socket used by carillonctl.
#control = "/var/run/carillon/carillon.sock"

# IERS/NIST leap-seconds.list. Optional for a client; required to announce
# leap seconds on a host that has no upstream servers.
#leapfile = "/var/db/carillon/leap-seconds.list"

# AES-128-CMAC keys in ntp.keys syntax, mode 0600. Required if any upstream
# below has a key id or a serve.require_key rule uses one. Generate with:
#   1  AES128CMAC  <32 hex digits>
#keys = "/usr/local/etc/carillon/keys"

# debug | info | warn | error
log_level = "info"

# --- PPS reference clock ---------------------------------------------------
# A bare PPS supplies a precise second boundary but not the second number. At
# least one selected [[server]] must keep the system within 0.4 seconds before
# PPS can qualify. When PPS is preferred, no server may also set prefer=true.
# Linux accepts either a tty (carillon attaches N_PPS) or an existing
# /dev/ppsN. FreeBSD uses the callout tty, never /dev/ttyuN.

#[[refclock]]
#name        = "pps0"
#type        = "pps"
#device      = "/dev/pps0"   # Linux; e.g. /dev/cuau0 on FreeBSD
#edge        = "assert"      # assert or clear
#offset      = 0.0            # fixed cable/driver correction, seconds
#prefer      = true
#noselect    = false
#lock_jitter = 0.0002         # use about 0.000020 for a real UART
#poll_min    = 4              # 16-s robust averaging window
#poll_max    = 7              # up to 128 s
#
# Inspect the pulse window with: carillonctl refclock

# --- GPS reference clock ---------------------------------------------------
# A GPS receiver always creates <name>/nmea. With PPS enabled it also creates
# <name>/pps; prefer applies to the precise PPS source, while NMEA remains the
# normal source that identifies each second. NMEA-only defaults to pps="none".
#
# FreeBSD can take NMEA and native UART PPS from the same callout tty; set pps
# to the pin selected by dev.uart.N.pps_mode. Linux N_PPS replaces the tty's
# serial line discipline, so NMEA must stay on device while pps names a
# separate /dev/ppsN, GPIO PPS device, or PPS-only tty.

#[[refclock]]
#name        = "gps"
#type        = "gps"
#device      = "/dev/cuau0" # Linux example: /dev/ttyS0
#baud        = 9600          # 4800, 9600, 19200, 38400, 57600, or 115200
#pps         = "dcd"        # FreeBSD: dcd/cts; Linux: separate /dev/ppsN; or none
#pps_edge    = "assert"
#pps_offset  = 0.0
#nmea_offset = 0.150         # fixed sentence-arrival correction, seconds
#sentences   = ["RMC", "ZDA"]
#prefer      = true
#noselect    = false
#lock_jitter = 0.000020
#poll_min    = 4
#poll_max    = 7
#
# carillonctl refclock reports fix, satellites, sentence freshness, and the
# measured median NMEA lag behind PPS as a calibration suggestion.

# --- Upstream servers -------------------------------------------------------
# Each [[server]] is polled independently. Three or more independent servers
# let the selection algorithm reject one that is wrong.

[[server]]
name    = "pool-a"
address = "0.pool.ntp.org"
iburst  = true

[[server]]
name    = "pool-b"
address = "1.pool.ntp.org"
iburst  = true

[[server]]
name    = "pool-c"
address = "2.pool.ntp.org"
iburst  = true

# An authenticated, preferred upstream — the home stratum-1 seen from the
# colo. Its offset is used unaltered whenever it survives selection; the
# public servers above then serve only to detect it being wrong. Requires
# `keys` above and the matching key id on both hosts.
#[[server]]
#name     = "home"
#address  = "10.9.0.1"       # WireGuard address of the home host
#key      = 1
#prefer   = true
#iburst   = true
#poll_min = 4                # log2 seconds: 16 s
#poll_max = 6                # 64 s

# Per-server keys and their defaults:
#   key      = 0      key id from the keys file; 0 = unauthenticated
#   prefer   = false  at most one server may be preferred
#   iburst   = false  burst of requests when the server becomes reachable
#   noselect = false  monitor only, never synchronize to it
#   poll_min = 6      log2 seconds (64 s); allowed 2..17
#   poll_max = 10     log2 seconds (1024 s); allowed 2..17

# --- NTP server -------------------------------------------------------------
# Serving is disabled unless `allow` contains at least one prefix. Deny rules
# take precedence. Replies are rate-limited per client address and are never
# longer than their requests. Modes 6 and 7 are never answered, and datagrams
# from unroutable source addresses are dropped whatever the ACL says.
# Uncomment the whole block to enable it.
#
# These settings are sized for a LAN. For a public server, see below.

#[serve]
#listen         = ["0.0.0.0:123", "[::]:123"]
#allow          = ["192.168.1.0/24", "2001:db8::/32"]
#deny           = []
#require_key    = { "203.0.113.7/32" = 1 }
#rate_limit_pps = 8
#rate_burst     = 16
#max_clients    = 65536
#kod            = true
#
# Inspect counters with: carillonctl serverstats

# --- NTP server, public internet (NTP pool) ---------------------------------
# Replace the block above with this one to serve the internet. carillon says
# so at startup when `allow` reaches beyond private address space, and repeats
# the warning for any setting below that is still at its LAN value.
#
#   allow          ::/0 would work for IPv6, but 2000::/3 is the global
#                  unicast range and is the narrower way to say the same
#                  thing. Both entries still let every unroutable source
#                  address through the ACL; the martian check behind it is
#                  what drops those. Add 127.0.0.0/8 and ::1/128 if this host
#                  also queries its own server.
#   rate_limit_pps A real client polls once every 64 seconds or slower, and an
#                  iburst is 4-8 packets 2 seconds apart. 0.25/s with a burst
#                  of 8 serves every legitimate client while cutting what one
#                  forged source address can draw out of this server by 32x.
#                  chrony and ntpd both default to about one packet every
#                  eight seconds.
#   rate_limit_v6_prefix
#                  IPv6 prefix one token bucket covers. Every residential
#                  IPv6 customer controls at least a /64, so a bucket per
#                  /128 lets one host draw rate_burst replies per address
#                  indefinitely and churn the table, evicting real clients.
#                  IPv4 is always per address.
#   max_clients    The rate-limit table is bounded and evicts the least
#                  recently used entry, so a flood of forged addresses costs
#                  fixed memory. Roughly 100 bytes an entry.
#   recv_buffer    The kernel default is a few hundred packets of headroom
#                  (208 KB on Linux, 42 KB on FreeBSD). A busy pool server
#                  outruns that in a burst, and the loss is invisible except
#                  as clients that never got an answer. Linux clamps the
#                  request to net.core.rmem_max silently. FreeBSD REFUSES a
#                  request above kern.ipc.maxsockbuf (default about 1.86 MB)
#                  with ENOBUFS rather than clamping it, so raise that sysctl
#                  first: carillon halves the request until the kernel takes
#                  it and warns, but you get the buffer you asked for only
#                  after the sysctl is raised. The size actually granted is
#                  logged at startup.
#                  On Linux carillon_server_kernel_drops_total counts what was
#                  lost anyway; FreeBSD has no per-socket count, so watch
#                  netstat -sp udp there instead.
#
#[serve]
#listen         = ["0.0.0.0:123", "[::]:123"]
#allow          = ["0.0.0.0/0", "2000::/3", "127.0.0.0/8", "::1/128"]
#deny           = []
#rate_limit_pps = 0.25
#rate_burst     = 8
#rate_limit_v6_prefix = 64
#max_clients    = 262144
#recv_buffer    = 4194304
#kod            = true

# --- Read-only HTTP monitoring ---------------------------------------------
# Disabled unless listen is set. The request ACL defaults to loopback even if
# listen is changed. Keep this on loopback when Apache proxies the status API
# over authenticated HTTPS; bind a private address and explicitly allow the
# LAN for direct access from an iPhone.

# If a confined process is going to scrape this endpoint on Fedora or RHEL,
# label the port first. SELinux decides TCP connections per port type, and a
# scraper such as a Zabbix agent (zabbix_agent_t) may reach http_port_t
# unconditionally but an unlabelled port only with the nis_enabled boolean,
# which is off by default. 9123 is worse than unlabelled: it is
# jboss_management_port_t, which is on no allow list at all.
#
#   semanage port -a -t http_port_t -p tcp 9124
#
# Without it connect() returns EACCES, the denial is dontaudit'd so audit.log
# stays empty, and curl renders it as "Could not connect to server" — which
# reads exactly like ECONNREFUSED and sends you hunting through firewall
# rules and namespaces. The same command works from a shell, because a login
# shell is not in the agent's domain.

#[monitor]
#listen = "127.0.0.1:9124"
#allow  = ["127.0.0.0/8", "::1/128"]
#id     = "twocom"
#name   = "Twocom"
#roles  = ["colo", "ntp-pool"]
#
# GET /api/v1/status  complete JSON snapshot (always 200 when readable)
# GET /healthz        200 healthy or degraded, 503 unhealthy
# GET /metrics        Prometheus exposition

# --- Daily statistics ------------------------------------------------------
# Optional daily UTC TSV files for tuning. Create this directory writable by
# the carillon user before enabling it. Files are buffered and flushed each
# minute and at shutdown.

#[stats]
#dir = "/var/db/carillon/stats"  # Linux: /var/lib/carillon/stats
#
# loop.YYYY-MM-DD.tsv     one row per discipline update
# sources.YYYY-MM-DD.tsv  one row per source per update
# pps.YYYY-MM-DD.tsv      one row per accepted pulse
# server.YYYY-MM-DD.tsv   one row per address family per minute, when the
#                         listener is enabled. The counters are cumulative
#                         since startup, so take differences between rows; a
#                         value that drops is a restart, not negative traffic.

# --- Discipline -------------------------------------------------------------
[discipline]
# Survivors required before a system source is declared at all. This is not
# the cluster algorithm's floor -- that is a fixed 3 (RFC 5905 NMIN) and is
# not configurable. Never set this above the number of sources configured, or
# the daemon will never synchronize.
min_survivors = 1
# Seconds to coast on the held frequency with no source before reporting
# unsynchronized.
holdover_max = 3600
# Maximum phase correction rate, ppm. The kernel caps total correction at
# 500 ppm, so slew capacity is 500 minus the frequency correction in use.
max_slew_ppm = 500
# Measurements for the system source that must arrive after a step before
# the clock is served as synchronized (DESIGN.md section 6.5). One is enough
# for the guards around it: a post-step loop update must also have run, and
# another step must no longer be on the table. Raise it on a path noisy
# enough that a single post-step sample is not convincing -- but note the
# server answers LI=3 / stratum 16 for the whole window, so every client and
# every downstream carillon rejects it while it counts.
settle_updates = 1

# --- Stepping policy --------------------------------------------------------
[step]
# Offsets larger than this (seconds) are stepped instead of slewed ...
threshold = 0.5
# ... but only within the first `limit` clock updates after start.
# -1 = steps always allowed (not for a time server), 0 = never step.
limit = 3
# Refuse to correct an offset larger than this (seconds) ...
panic = 1000
# ... except for the very first correction when this is true. Set it on
# hosts without a battery-backed clock (some SBCs).
panic_at_startup = false
