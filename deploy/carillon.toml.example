# carillon configuration — NTP client/server with optional PPS refclock.
#
# Install as:
#   /usr/local/etc/carillon/carillon.toml   (FreeBSD)
#   /etc/carillon/carillon.toml             (Linux)
#   /etc/carillon.toml                      (OpenWrt)
# or pass -config /path/to/carillon.toml.
#
# Unknown keys are errors: a typo will stop the daemon from starting rather
# than silently doing nothing. Validate with: carillon -check -config <path>

[daemon]
# Last known frequency correction, read at start and written hourly.
#   FreeBSD default: /var/db/carillon/drift
#   Linux default:   /var/lib/carillon/drift
#drift_file = "/var/db/carillon/drift"

# Unix socket used by carillonctl.
#control = "/var/run/carillon/carillon.sock"

# IERS/NIST leap-seconds.list. Optional for a client; required to announce
# leap seconds on a host that has no upstream servers.
#leapfile = "/var/db/carillon/leap-seconds.list"

# AES-128-CMAC keys in ntp.keys syntax, mode 0600. Required if any upstream
# below has a key id or a serve.require_key rule uses one. Generate with:
#   1  AES128CMAC  <32 hex digits>
#keys = "/usr/local/etc/carillon/keys"

# debug | info | warn | error
log_level = "info"

# --- PPS reference clock ---------------------------------------------------
# A bare PPS supplies a precise second boundary but not the second number. At
# least one selected [[server]] must keep the system within 0.4 seconds before
# PPS can qualify. When PPS is preferred, no server may also set prefer=true.
# Linux accepts either a tty (carillon attaches N_PPS) or an existing
# /dev/ppsN. FreeBSD uses the callout tty, never /dev/ttyuN.

#[[refclock]]
#name        = "pps0"
#type        = "pps"
#device      = "/dev/pps0"   # Linux; e.g. /dev/cuau0 on FreeBSD
#edge        = "assert"      # assert or clear
#offset      = 0.0            # fixed cable/driver correction, seconds
#prefer      = true
#noselect    = false
#lock_jitter = 0.0002         # use about 0.000020 for a real UART
#poll_min    = 4              # 16-s robust averaging window
#poll_max    = 7              # up to 128 s
#
# Inspect the pulse window with: carillonctl refclock

# --- Upstream servers -------------------------------------------------------
# Each [[server]] is polled independently. Three or more independent servers
# let the selection algorithm reject one that is wrong.

[[server]]
name    = "pool-a"
address = "0.pool.ntp.org"
iburst  = true

[[server]]
name    = "pool-b"
address = "1.pool.ntp.org"
iburst  = true

[[server]]
name    = "pool-c"
address = "2.pool.ntp.org"
iburst  = true

# An authenticated, preferred upstream — the home stratum-1 seen from the
# colo. Its offset is used unaltered whenever it survives selection; the
# public servers above then serve only to detect it being wrong. Requires
# `keys` above and the matching key id on both hosts.
#[[server]]
#name     = "home"
#address  = "10.9.0.1"       # WireGuard address of the home host
#key      = 1
#prefer   = true
#iburst   = true
#poll_min = 4                # log2 seconds: 16 s
#poll_max = 6                # 64 s

# Per-server keys and their defaults:
#   key      = 0      key id from the keys file; 0 = unauthenticated
#   prefer   = false  at most one server may be preferred
#   iburst   = false  burst of requests when the server becomes reachable
#   noselect = false  monitor only, never synchronize to it
#   poll_min = 6      log2 seconds (64 s); allowed 2..17
#   poll_max = 10     log2 seconds (1024 s); allowed 2..17

# --- NTP server -------------------------------------------------------------
# Serving is disabled unless `allow` contains at least one prefix. Deny rules
# take precedence. Replies are rate-limited per client address and are never
# longer than their requests. Uncomment the whole block to enable it.

#[serve]
#listen         = ["0.0.0.0:123", "[::]:123"]
#allow          = ["192.168.1.0/24", "2001:db8::/32"]
#deny           = []
#require_key    = { "203.0.113.7/32" = 1 }
#rate_limit_pps = 8
#rate_burst     = 16
#kod            = true
#
# Inspect counters with: carillonctl serverstats

# --- Discipline -------------------------------------------------------------
[discipline]
# Smallest number of sources the cluster algorithm keeps.
min_survivors = 1
# Seconds to coast on the held frequency with no source before reporting
# unsynchronized.
holdover_max = 3600
# Maximum phase correction rate, ppm. The kernel caps total correction at
# 500 ppm, so slew capacity is 500 minus the frequency correction in use.
max_slew_ppm = 500

# --- Stepping policy --------------------------------------------------------
[step]
# Offsets larger than this (seconds) are stepped instead of slewed ...
threshold = 0.5
# ... but only within the first `limit` clock updates after start.
# -1 = steps always allowed (not for a time server), 0 = never step.
limit = 3
# Refuse to correct an offset larger than this (seconds) ...
panic = 1000
# ... except for the very first correction when this is true. Set it on
# hosts without a battery-backed clock (OpenWrt routers, some SBCs).
panic_at_startup = false
